rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Entity Validators
    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 120;
    }

    function isValidProject(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.key is string && data.key.size() > 0 && data.key.size() <= 10 &&
             data.ownerId is string && data.ownerId.size() <= 128;
    }

    function isValidIssue(data) {
      return data.projectId is string && data.projectId.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.status is string && data.status.size() <= 30 &&
             data.priority is string && data.priority.size() <= 20 &&
             data.type is string && data.type.size() <= 20;
    }

    function isValidSprint(data) {
      return data.projectId is string && data.projectId.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.status is string && data.status.size() <= 20;
    }

    function isValidComment(data) {
      return data.issueId is string && data.issueId.size() <= 128 &&
             data.authorId is string && data.authorId == request.auth.uid &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 3000;
    }

    function isValidChannel(data) {
      return data.projectId is string && data.projectId.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 50 &&
             data.type is string && data.type.size() <= 20;
    }

    function isValidMessage(data) {
      return data.channelId is string && data.channelId.size() <= 128 &&
             data.authorId is string && data.authorId == request.auth.uid &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 4000;
    }

    function isValidPresence(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.status is string && data.status.size() <= 20;
    }

    function isValidActivity(data) {
      return data.projectId is string && data.projectId.size() <= 128 &&
             data.type is string && data.type.size() <= 50 &&
             data.message is string && data.message.size() <= 300;
    }

    function isValidGitHubConnection(data) {
      return data.projectId is string && data.projectId.size() <= 128 &&
             data.repoName is string && data.repoName.size() <= 100 &&
             data.repoOwner is string && data.repoOwner.size() <= 100;
    }

    function isValidGitHubActivity(data) {
      return data.projectId is string && data.projectId.size() <= 128 &&
             data.repoName is string && data.repoName.size() <= 100 &&
             data.eventType is string && data.eventType.size() <= 50;
    }

    function isValidNotification(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 150 &&
             data.read is bool;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) && isValidUser(incoming());
      allow delete: if false;
    }

    // Workspaces Collection
    match /workspaces/{workspaceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Projects Collection
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidProject(incoming()) && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && isValidProject(incoming());
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }

    // Issues Collection
    match /issues/{issueId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidIssue(incoming());
      allow update: if isSignedIn() && isValidIssue(incoming());
      allow delete: if isSignedIn();
    }

    // Sprints Collection
    match /sprints/{sprintId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidSprint(incoming());
      allow update: if isSignedIn() && isValidSprint(incoming());
      allow delete: if isSignedIn();
    }

    // Comments Collection
    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidComment(incoming());
      allow update: if isSignedIn() && existing().authorId == request.auth.uid && isValidComment(incoming());
      allow delete: if isSignedIn() && existing().authorId == request.auth.uid;
    }

    // Channels Collection
    match /channels/{channelId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidChannel(incoming());
      allow update: if isSignedIn() && isValidChannel(incoming());
      allow delete: if isSignedIn();
    }

    // Messages Collection
    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidMessage(incoming());
      allow update: if isSignedIn() && (existing().authorId == request.auth.uid || incoming().diff(existing()).affectedKeys().hasOnly(['reactions']));
      allow delete: if isSignedIn() && existing().authorId == request.auth.uid;
    }

    // Presence Collection
    match /presence/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) && isValidPresence(incoming());
      allow delete: if isOwner(userId);
    }

    // Activity Feed Collection
    match /activities/{activityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidActivity(incoming());
      allow update, delete: if false;
    }

    // GitHub Connections Collection
    match /githubConnections/{connId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidGitHubConnection(incoming());
      allow delete: if isSignedIn();
    }

    // GitHub Activities Collection
    match /githubActivity/{actId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidGitHubActivity(incoming());
      allow delete: if isSignedIn();
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidNotification(incoming());
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Project Threads & RMMM Risk System Collection
    match /threads/{threadId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Thread Messages Collection
    match /threadMessages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // WebRTC Signaling Calls Collection
    match /calls/{callId} {
      allow read, write: if isSignedIn();

      match /peers/{peerId} {
        allow read, write: if isSignedIn();
      }
    }
  }
}

